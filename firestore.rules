rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // An admin is anyone who has a document in the "admins" collection.
    // Documents there can only be created by you in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Account record: name, email, plan, activity counts.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.plan == 'free';
      // Users can update their own record but never change their own plan.
      allow update: if (isOwner(uid) && request.resource.data.plan == resource.data.plan) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Private food logs, workouts, plans. Only the owner can read or write.
    match /userData/{uid} {
      allow read, write: if isOwner(uid);
      match /days/{day} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
